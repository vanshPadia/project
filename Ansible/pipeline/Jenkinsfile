@Library('ansible-lib') _ 
pipeline {
    agent any


    environment {
        AWS_REGION = 'ap-south-1'
    }

    stages {
        stage('Deploy EC2') {
            steps {
                withFolderProperties {
                    withAWS(credentials: 'aws', region: AWS_REGION ) {
                        cfnUpdate(
                            stack: "${env.environment}-ansible",
                            file: 'iac/aws/cloudformation/jenkins.yml',
                            params: [
                                environment: env.environment,
                                keyName:env.keyName                            
                            ],
                            timeoutInMinutes: 30
                        )
                    }
                }
            }
        }
        stage('Start Ansible') {
            steps {
                script{
                    test()
                }
                timeoutInMinutes: 30
            }
        }              
    }
}
